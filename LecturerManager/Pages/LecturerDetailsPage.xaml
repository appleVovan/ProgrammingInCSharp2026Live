<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:KMA.ProgrammingInCSharp2026.LecturerManager.Pages"
             xmlns:models="clr-namespace:KMA.ProgrammingInChsarp2026.LecturerManager.DTOModels.Lecturers;assembly=LecturerManager.DTOModels"
             xmlns:vm="clr-namespace:KMA.ProgrammingInCSharp2026.LecturerManager.ViewModels"
             x:Class="KMA.ProgrammingInCSharp2026.LecturerManager.Pages.LecturerDetailsPage"
             x:DataType="vm:LecturerDetailsViewModel"
             Title="Lecturer Details">
    <ScrollView>
        <VerticalStackLayout
            Padding="10,20"
            Spacing="10">
            <Label
                Text="FirstName"></Label>
            <Label
                Text="{Binding FirstName}"
                Margin="10,0"></Label>
            <Label
                Text="LastName"></Label>
            <Label
                Text="{Binding LastName}"
                Margin="10,0"></Label>
            <Label
                Text="Postion"></Label>
            <Label
                Text="{Binding Position, Converter={StaticResource EnumToDisplayName}}"
                Margin="10,0"></Label>
            <Label
                Text="Date of Birth"></Label>
            <Label
                Text="{Binding DateOfBirth, StringFormat='{0:MMMM dd, yyyy}'}"
                Margin="10,0"></Label>
            <Label
                Text="Age"></Label>
            <Label
                Text="{Binding Age}"
                Margin="10,0"></Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>