<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:KMA.ProgrammingInCSharp2026.LecturerManager.Pages"
             xmlns:models="clr-namespace:KMA.ProgrammingInChsarp2026.LecturerManager.UIModels;assembly=LecturerManager.UIModels"
             x:Class="KMA.ProgrammingInCSharp2026.LecturerManager.Pages.DepartmentsPage"
             x:DataType="pages:DepartmentsPage"
             Title="Departments">
    <CollectionView
        ItemsSource="{Binding Departments}"
        Margin="10"
        SelectionMode="Single">
        <CollectionView.ItemTemplate>
            <DataTemplate
                x:DataType="models:DepartmentUIModel">
                <Border
                    Stroke="Magenta"
                    Padding="10"
                    Margin="0,10">
                    <VerticalStackLayout>
                        <Label
                            Text="{Binding .}"></Label>
                    </VerticalStackLayout>                    
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>