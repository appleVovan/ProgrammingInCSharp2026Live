<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:KMA.ProgrammingInCSharp2026.LecturerManager.Pages"
             xmlns:models="clr-namespace:KMA.ProgrammingInChsarp2026.LecturerManager.DTOModels.Departments;assembly=LecturerManager.DTOModels"
             xmlns:vm="clr-namespace:KMA.ProgrammingInCSharp2026.LecturerManager.ViewModels"
             xmlns:tools="clr-namespace:KMA.ProgrammingInCSharp2026.LecturerManager.Tools"
             x:Class="KMA.ProgrammingInCSharp2026.LecturerManager.Pages.DepartmentsPage"
             x:DataType="vm:DepartmentsViewModel"
             Title="Departments">    
    <CollectionView
        ItemsSource="{Binding Departments}"
        Margin="10"
        SelectionMode="Single"
        SelectedItem="{Binding SelectedDepartment}"
        SelectionChangedCommand="{Binding DepartmentSelectedCommand}">
        <CollectionView.ItemTemplate>
            <DataTemplate
                x:DataType="models:DepartmentListDTO">
                <Border
                    Stroke="Magenta"
                    Padding="10"
                    Margin="0,10">
                    <VerticalStackLayout>
                        <Label
                            Style="{StaticResource SubHeadline}">
                            <MultiBinding
                                StringFormat="{}{0} (Staff: {1})">
                                <Binding Path="Name"></Binding>
                                <Binding Path="LecturersCount"></Binding>
                            </MultiBinding>
                        </Label>
                        <Label
                            Text="{Binding Faculty, Converter={StaticResource EnumToDisplayName}}"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>                    
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>