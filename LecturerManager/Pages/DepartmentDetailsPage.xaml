<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:KMA.ProgrammingInCSharp2026.LecturerManager.Pages"
             xmlns:models="clr-namespace:KMA.ProgrammingInChsarp2026.LecturerManager.DTOModels.Lecturers;assembly=LecturerManager.DTOModels"
             xmlns:vm="clr-namespace:KMA.ProgrammingInCSharp2026.LecturerManager.ViewModels"
             x:Class="KMA.ProgrammingInCSharp2026.LecturerManager.Pages.DepartmentDetailsPage"
             x:DataType="vm:DepartmentDetailsViewModel"
             Title="Department Details" IsEnabled="{Binding IsNotBusy}">
    <Grid RowDefinitions="Auto, *">
        <Border
            Stroke="Blue"
            Padding="10"
            Margin="0,10">
            <VerticalStackLayout>
                <Label
                    Style="{StaticResource Headline}"
                    Text="{Binding CurrentDepartment.Name}"/>
                <Label
                    Style="{StaticResource SubHeadline}"
                    Text="{Binding CurrentDepartment.Faculty, Converter={StaticResource EnumToDisplayName}}"
                    HorizontalOptions="Center"/>
                <Label
                    Text="{Binding CurrentDepartment.Email}"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>
        <CollectionView Grid.Row="1"
                ItemsSource="{Binding Lecturers}"
                Margin="10"
                SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate
                        x:DataType="models:LecturerListDTO">
                    <Border
                        Stroke="Magenta"
                        Padding="10"
                        Margin="0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentDetailsViewModel}}, Path=LoadLecturerCommand}"
                                    CommandParameter="{Binding Id}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label
                                    Style="{StaticResource SubHeadline}">
                                <MultiBinding
                                        StringFormat="{}{0} {1}">
                                    <Binding Path="FirstName"></Binding>
                                    <Binding Path="LastName"></Binding>
                                </MultiBinding>
                            </Label>
                            <Label
                                    Text="{Binding Position, Converter={StaticResource EnumToDisplayName}}"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <BoxView
            IsVisible="{Binding IsBusy}"
            BackgroundColor="Gray"
            Opacity="0.2"
            InputTransparent="False"
            Grid.RowSpan="2"/>
        <ActivityIndicator
            Color="Magenta"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>